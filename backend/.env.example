SYSTEM_PROMPT={"role":"system","content":"Ban la luat su.\n\nNhiem vu:\n- Tom tat vu an\n- Giai thich cac dieu luat\n- Phan tich chi tiet cac tinh huong phap ly\n- Tra loi ngan gon va chinh xac"}
CHROMA_PATH=../rag/chroma_db
EMBED_MODEL=BAAI/bge-m3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# Nạp model khi FastAPI khởi động, giữ model trong RAM/VRAM trong thời gian này.
OLLAMA_WARMUP_ENABLED=true
OLLAMA_KEEP_ALIVE=30m
# Backend vẫn khởi động nếu Ollama/model chưa sẵn sau thời gian chờ này.
OLLAMA_STARTUP_TIMEOUT_SECONDS=120
